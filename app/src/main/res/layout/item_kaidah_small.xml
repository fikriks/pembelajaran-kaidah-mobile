<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Kaidah Icon -->
        <ImageView
            android:id="@+id/ivKaidahIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_kaidah_icon"
            android:padding="12dp"
            android:src="@drawable/ic_book"
            android:contentDescription="Icon Kaidah" />

        <!-- Kaidah Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Kaidah Title -->
            <TextView
                android:id="@+id/tvKaidahTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Judul Kaidah"
                android:textAppearance="@style/TextAppearance.PembelajaranKaidah.BodyLarge"
                android:textColor="@color/text_primary"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Progress Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textAppearance="@style/TextAppearance.PembelajaranKaidah.BodyMedium"
                    android:textColor="@color/primary_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="•"
                    android:textAppearance="@style/TextAppearance.PembelajaranKaidah.BodyMedium"
                    android:textColor="@color/text_hint" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Belum dimulai"
                    android:textAppearance="@style/TextAppearance.PembelajaranKaidah.BodyMedium"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

        </LinearLayout>

        <!-- Action Arrow -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_right"
            android:contentDescription="Action"
            android:tint="@color/gray_400" />

    </LinearLayout>

</androidx.cardview.widget.CardView>