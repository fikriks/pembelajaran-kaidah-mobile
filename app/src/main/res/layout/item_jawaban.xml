<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/cardJawaban"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white"
    app:strokeWidth="1dp"
    app:strokeColor="@color/gray_300"
    app:rippleColor="@color/primary_green_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Option Letter -->
        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:background="@drawable/bg_circle_gray_light"
            android:layout_marginEnd="16dp"
            android:id="@+id/tvOptionLetter" />

        <!-- Jawaban Text -->
        <TextView
            android:id="@+id/tvJawaban"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="كُتُبٌ (kutubun)"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Check Icon -->
        <ImageView
            android:id="@+id/ivCheck"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_check_circle"
            android:layout_marginStart="12dp"
            android:visibility="gone"
            android:contentDescription="Selected" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>