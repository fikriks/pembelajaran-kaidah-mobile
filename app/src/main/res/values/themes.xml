<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with minimalis green design -->
    <style name="Base.Theme.PembelajaranKaidah" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_green_light</item>
        <item name="colorOnPrimaryContainer">@color/primary_green_dark</item>

        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/secondary_green</item>
        <item name="colorOnSecondary">@color/text_on_primary</item>
        <item name="colorSecondaryContainer">@color/secondary_green_light</item>
        <item name="colorOnSecondaryContainer">@color/secondary_green_dark</item>

        <!-- Background Colors -->
        <item name="android:colorBackground">@color/background_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/background_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/gray_100</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/primary_green</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/background_card</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Typography -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.PembelajaranKaidah.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.PembelajaranKaidah.HeadlineMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.PembelajaranKaidah.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.PembelajaranKaidah.BodyMedium</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.PembelajaranKaidah.LabelLarge</item>

        <!-- Shape -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.PembelajaranKaidah.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.PembelajaranKaidah.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.PembelajaranKaidah.LargeComponent</item>
    </style>

    <style name="Theme.PembelajaranKaidah" parent="Base.Theme.PembelajaranKaidah" />

    <!-- Text Styles -->
    <style name="TextAppearance.PembelajaranKaidah.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.PembelajaranKaidah.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.PembelajaranKaidah.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.PembelajaranKaidah.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.PembelajaranKaidah.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary_green</item>
    </style>

    <!-- Arabic Text Style -->
    <style name="TextAppearance.PembelajaranKaidah.ArabicLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_arabic</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:gravity">end</item>
    </style>

    <style name="TextAppearance.PembelajaranKaidah.ArabicMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_arabic</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:gravity">end</item>
    </style>

    <!-- Shape Styles -->
    <style name="ShapeAppearance.PembelajaranKaidah.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.PembelajaranKaidah.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.PembelajaranKaidah.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.PembelajaranKaidah.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.PembelajaranKaidah.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textColor">@color/primary_green</item>
        <item name="strokeColor">@color/primary_green</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- Card Style -->
    <style name="Widget.PembelajaranKaidah.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="android:layout_margin">8dp</item>
    </style>

    <!-- TextInput Style -->
    <style name="Widget.PembelajaranKaidah.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary_green</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/text_hint</item>
    </style>

    <!-- Chip Style -->
    <style name="Widget.PembelajaranKaidah.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/primary_green_light</item>
        <item name="chipStrokeColor">@color/primary_green</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/primary_green_dark</item>
        <item name="chipCornerRadius">20dp</item>
    </style>

    <!-- Bottom Navigation Active Indicator -->
    <style name="Widget.PembelajaranKaidah.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_green</item>
        <item name="android:marginHorizontal">12dp</item>
        <item name="android:layout_height">3dp</item>
    </style>
</resources>