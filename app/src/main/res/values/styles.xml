<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme -->
    <style name="Theme.PembelajaranKaidah" parent="Theme.Material3.DayNight">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_green_light</item>
        <item name="colorOnPrimaryContainer">@color/primary_green_dark</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary_green</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/secondary_green_light</item>
        <item name="colorOnSecondaryContainer">@color/secondary_green_dark</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/primary_green_dark</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- Bottom Navigation Active Indicator -->
    <style name="Widget.PembelajaranKaidah.BottomNavigation.ActiveIndicator" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">3dp</item>
        <item name="android:background">@color/primary_green</item>
        <item name="android:layout_marginHorizontal">16dp</item>
    </style>

    <!-- Card Style -->
    <style name="Widget.PembelajaranKaidah.Card" parent="Widget.Material3.CardView">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/border_light</item>
    </style>

    <!-- Button Style -->
    <style name="Widget.PembelajaranKaidah.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <!-- Text Input Style -->
    <style name="Widget.PembelajaranKaidah.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/border_input</item>
        <item name="boxStrokeWidth">1dp</item>
    </style>

    <!-- RecyclerView Style -->
    <style name="Widget.PembelajaranKaidah.RecyclerView" parent="">
        <item name="android:scrollbars">vertical</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:padding">8dp</item>
    </style>

</resources>